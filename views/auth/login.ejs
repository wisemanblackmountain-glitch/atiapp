<%#
  PARTICIPANT LOGIN

  Route:   GET  /login   → render
           POST /login   → { participantNumber, lastName, accessPin }   [LOCKED §14]
  Layout:  nav: 'none'

  Locals
    title        String
    csrfToken    String
    error        String?   rendered by the layout, above the view body
    values       Object?   { participantNumber, lastName } to repopulate after a failed attempt.
                           accessPin is never echoed back.
    lockedUntil  String?   human-readable time; set when the rate limiter has tripped
                           (5 attempts / 15 min per IP)
%>

<div class="split">

  <div class="split-brand">
    <div class="row" style="gap:10px;margin-bottom:var(--sp-6)">
      <span class="nav-seal" aria-hidden="true">A</span>
      <strong style="font-family:var(--font-display);font-size:15px">ATI &middot; ZMATF</strong>
    </div>

    <h2>Executive Training Programme</h2>
    <p style="color:#B4C0B7;font-size:15px;max-width:34ch">
      Pre-training diagnostic assessment for the Zanzibar Multi-Agency Task Force.
    </p>

    <ul style="list-style:none;padding:0;margin:var(--sp-5) 0 0;color:#B4C0B7;font-size:14px">
      <li class="row" style="gap:var(--sp-2);margin-bottom:var(--sp-2)">
        <span class="font-mono" style="color:var(--color-terracotta-on-dark)">20</span>
        <span>questions across two sections</span>
      </li>
      <li class="row" style="gap:var(--sp-2);margin-bottom:var(--sp-2)">
        <span class="font-mono" style="color:var(--color-terracotta-on-dark)">10</span>
        <span>minutes, timed from when you begin</span>
      </li>
      <li class="row" style="gap:var(--sp-2)">
        <span class="font-mono" style="color:var(--color-terracotta-on-dark)">01</span>
        <span>attempt per officer</span>
      </li>
    </ul>

    <div class="font-mono"
         style="font-size:11px;color:#7C8A82;letter-spacing:.05em;margin-top:auto;padding-top:var(--sp-5)">
      REVOLUTIONARY GOVERNMENT OF ZANZIBAR
    </div>
  </div>

  <div class="split-form">
    <h2 style="font-size:26px">Verify your identity</h2>
    <p class="text-muted" style="font-size:15px;margin-bottom:var(--sp-5)">
      Enter the credentials issued to you by the programme secretariat.
    </p>

    <% if (typeof lockedUntil !== 'undefined' && lockedUntil) { %>
      <div class="alert alert-danger" role="alert" style="margin-bottom:var(--sp-4)">
        Too many failed attempts from this location. Try again after <%= lockedUntil %>.
      </div>
    <% } %>

    <form method="POST" action="/login" novalidate>
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

      <div class="form-group">
        <label for="participantNumber" class="form-label">
          <span>Participant number</span>
          <span class="form-hint">1&ndash;32</span>
        </label>
        <input type="text" id="participantNumber" name="participantNumber"
               class="form-input font-mono"
               inputmode="numeric" pattern="[0-9]{1,2}" maxlength="2"
               autocomplete="off" required
               placeholder="07"
               value="<%= typeof values !== 'undefined' && values.participantNumber ? values.participantNumber : '' %>">
      </div>

      <div class="form-group">
        <label for="lastName" class="form-label">
          <span>Surname</span>
          <span class="form-hint">As registered</span>
        </label>
        <input type="text" id="lastName" name="lastName"
               class="form-input"
               autocomplete="family-name" autocapitalize="characters" required
               placeholder="Your surname"
               value="<%= typeof values !== 'undefined' && values.lastName ? values.lastName : '' %>">
      </div>

      <div class="form-group">
        <label for="accessPin" class="form-label">
          <span>Access PIN</span>
          <span class="form-hint">6 digits</span>
        </label>
        <input type="password" id="accessPin" name="accessPin"
               class="form-input font-mono"
               inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
               autocomplete="off" required
               placeholder="&bull;&bull;&bull;&bull;&bull;&bull;">
      </div>

      <button type="submit" class="btn btn-terracotta btn-lg btn-block">
        <span>Continue</span>
        <svg class="btn-arrow" width="18" height="18" viewBox="0 0 20 20"
             fill="none" aria-hidden="true" focusable="false">
          <path d="M7 4l6 6-6 6" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </form>

    <p class="text-faint" style="font-size:13px;margin-top:var(--sp-5);margin-bottom:0">
      Lost your credentials? Contact the programme secretariat. Facilitators sign in
      <a href="/admin/login">here</a>.
    </p>
  </div>

</div>
