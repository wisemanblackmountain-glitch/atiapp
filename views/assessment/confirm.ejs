<%#
  IDENTITY CONFIRMATION

  Route:   GET /assessment/confirm
  Next:    GET /assessment/instructions  (link, no state change)
           POST /logout                  (if the officer is not who is shown)
  Layout:  nav: 'default'

  Locals
    title        String
    csrfToken    String
    participant  Object  { participant_number, full_name, title, agency }

  The timer has NOT started at this point. Nothing here writes to
  assessment_attempts — the attempt begins on POST /assessment/start from the
  instructions screen.
%>

<div class="container container-narrow section">

  <div class="label-meta">Step 1 of 3 &middot; Identity</div>
  <h1 style="font-size:clamp(26px,3.4vw,34px)">Confirm your details</h1>
  <p class="text-muted" style="font-size:16px;margin-bottom:var(--sp-5)">
    Check that these details are yours before continuing. Your result is filed
    against this record.
  </p>

  <div class="card card-lg">
    <div class="stack" style="gap:0">

      <div class="row" style="gap:var(--sp-4);padding-bottom:var(--sp-4);border-bottom:1px solid var(--border-soft)">
        <div style="min-width:140px"><span class="label-meta" style="margin:0">Participant number</span></div>
        <div class="font-mono" style="font-size:17px;font-weight:600">
          <%= participant.participant_number %>
        </div>
      </div>

      <div class="row" style="gap:var(--sp-4);padding:var(--sp-4) 0;border-bottom:1px solid var(--border-soft)">
        <div style="min-width:140px"><span class="label-meta" style="margin:0">Full name</span></div>
        <div style="font-size:16px;font-weight:650"><%= participant.full_name %></div>
      </div>

      <div class="row" style="gap:var(--sp-4);padding:var(--sp-4) 0;border-bottom:1px solid var(--border-soft)">
        <div style="min-width:140px"><span class="label-meta" style="margin:0">Designation</span></div>
        <div style="font-size:15px"><%= participant.title %></div>
      </div>

      <div class="row" style="gap:var(--sp-4);padding-top:var(--sp-4)">
        <div style="min-width:140px"><span class="label-meta" style="margin:0">Agency</span></div>
        <div style="font-size:15px"><%= participant.agency %></div>
      </div>

    </div>
  </div>

  <div class="alert" style="margin-top:var(--sp-4)">
    Your responses are recorded against this officer record and are visible to
    programme facilitators. The ten-minute timer has not started yet.
  </div>

  <div class="row" style="gap:var(--sp-3);margin-top:var(--sp-5)">
    <a href="/assessment/instructions" class="btn btn-terracotta btn-lg">
      <span>Yes, this is me</span>
      <svg class="btn-arrow" width="18" height="18" viewBox="0 0 20 20"
           fill="none" aria-hidden="true" focusable="false">
        <path d="M7 4l6 6-6 6" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>

    <form method="POST" action="/logout" style="display:inline">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <button type="submit" class="btn btn-ghost">This is not me</button>
    </form>
  </div>

</div>
