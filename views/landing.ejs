<%#
  Landing portal — institutional entry point.
  Rendered by server.js GET '/'. Receives only `title`, so this view must not
  depend on any other local.
%>

<div class="container section">

  <div class="card card-lg" style="text-align:left">
    <div class="row" style="gap:var(--sp-4);margin-bottom:var(--sp-5)">
      <span class="nav-seal emblem-icon" aria-hidden="true"
            style="width:44px;height:44px;font-size:19px;border-radius:var(--r-sm)">A</span>
      <div>
        <div class="label-meta" style="margin-bottom:2px">Africa Transformational Initiative</div>
        <div class="font-mono" style="font-size:12px;color:var(--text-muted)">
          Revolutionary Government of Zanzibar
        </div>
      </div>
    </div>

    <h1 style="max-width:20ch">ZMATF Executive Training Programme</h1>
    <p class="text-muted" style="font-size:17px;max-width:56ch">
      Pre-training diagnostic assessment for the Zanzibar Multi-Agency Task Force.
      This establishes a baseline measure of domain knowledge before the programme begins.
    </p>

    <div class="metric-grid" style="margin:var(--sp-6) 0">
      <div class="metric">
        <span class="metric-value">20</span>
        <div class="metric-label">Questions</div>
      </div>
      <div class="metric">
        <span class="metric-value">10</span>
        <div class="metric-label">Minutes</div>
      </div>
      <div class="metric">
        <span class="metric-value">20</span>
        <div class="metric-label">Total marks</div>
      </div>
      <div class="metric">
        <span class="metric-value">32</span>
        <div class="metric-label">Authorised officers</div>
      </div>
    </div>

    <div class="row" style="gap:var(--sp-3)">
      <a href="/login" class="btn btn-terracotta btn-lg">
        <span>Begin assessment</span>
        <svg class="btn-arrow" width="18" height="18" viewBox="0 0 20 20"
             fill="none" aria-hidden="true" focusable="false">
          <path d="M7 4l6 6-6 6" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="/admin/login" class="btn btn-ghost">Facilitator access</a>
    </div>
  </div>

  <div class="alert" style="margin-top:var(--sp-5);max-width:72ch">
    This is a baseline diagnostic, not a pass or fail examination. Your result
    informs how the training is pitched. Correct answers are not disclosed at any point.
  </div>

</div>
