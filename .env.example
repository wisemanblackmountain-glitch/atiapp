# ATI ZMATF Assessment System — Environment Configuration
# ========================================================
# Copy this file to .env and fill in every value.
# NEVER commit .env to version control.

# ── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Database ─────────────────────────────────────────────
# PostgreSQL connection string.
#
# Production (Neon): copy the pooled connection string from the Neon dashboard.
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
#
# Local development, using the container in the README:
#   postgresql://postgres:ati_dev_local@localhost:5433/ati_zmatf
#
# TLS is negotiated automatically for non-local hosts. Set PGSSL=disable only
# if you are certain the connection is already private.
DATABASE_URL=

# Maximum pooled connections. Keep small — Neon's free plan caps concurrent
# connections and the Render instance is a single small process.
PG_POOL_MAX=5

# ── Session ──────────────────────────────────────────────
# Cryptographically random, minimum 32 characters. Rotating this signs
# everyone out, which is the intended effect after any exposure.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ── Administrator ────────────────────────────────────────
# Used by database/seed.js to create the facilitator account. The password is
# stored only as a bcrypt hash. Minimum 12 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Assessment ───────────────────────────────────────────
# Duration in minutes. The server is authoritative on expiry; the client
# countdown is display only.
ASSESSMENT_DURATION=10
