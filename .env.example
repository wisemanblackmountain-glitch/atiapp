# ATI ZMATF Assessment System - Environment Configuration
# ========================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
#
# All values below are REQUIRED for the application to start.

# Server
PORT=3000
NODE_ENV=production

# Session Secret - MUST be a cryptographically random string, minimum 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Admin Credentials - configure securely, never use defaults
# Password must be minimum 12 characters
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Assessment Duration (minutes)
ASSESSMENT_DURATION=10
