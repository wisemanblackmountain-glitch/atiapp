# ── Dependencies ───────────────────────────────────────────
node_modules/

# ── Secrets & environment ──────────────────────────────────
# Never commit real environment files. Commit .env.example only.
.env
.env.*
!.env.example

# ── Participant credentials & personal data ────────────────
# Contains named officers and access PINs. Must never be tracked.
participant-credentials.txt
participants.txt

# ── Official source documents ──────────────────────────────
# Master question paper contains the answer key.
# Annex contains named participants and facilitators.
*.doc
*.docx
pre-training-test.txt

# ── Database ───────────────────────────────────────────────
database/*.db
database/*.db-wal
database/*.db-shm

# ── Local QA harness ───────────────────────────────────────
# Component gallery for style.css. Not committed: express.static
# would serve it as a public route.
public/qa.html

# ── Logs & OS cruft ────────────────────────────────────────
*.log
npm-debug.log*
.DS_Store
Thumbs.db
